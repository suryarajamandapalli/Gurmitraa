{
  "rules": {
    // Global site configuration: public read, admin write
    "global": {
      ".read": true,
      ".write": "auth != null"
    },

    // Page contents and sections: public read, admin write
    "pages": {
      ".read": true,
      ".write": "auth != null"
    },

    // Media library assets: public read, admin write
    "media": {
      ".read": true,
      ".write": "auth != null"
    },

    // Contact form submissions: public write (contact form), admin read/delete
    "submissions": {
      ".read": "auth != null",
      ".write": true
    },

    // Site settings: admin only
    "settings": {
      ".read": "auth != null",
      ".write": "auth != null"
    },

    // Default rule: allow public read, require authenticated admin write
    ".read": true,
    ".write": "auth != null"
  }
}
